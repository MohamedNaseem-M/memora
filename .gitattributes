# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf

# Binary files — do not modify
*.ico  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.svg  binary
*.woff binary
*.woff2 binary
